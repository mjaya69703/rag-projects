# Salin file ini menjadi .env lalu isi nilainya.
# JANGAN commit .env ke git.

# --- LLM API (dipakai mulai Sprint 2) ---
LLM_API_KEY=
LLM_API_BASE=
LLM_MODEL=

# --- Path penyimpanan ---
PERSIST_DIR=data/chroma_db
UPLOAD_DIR=uploads
DB_PATH=data/chat.db

# --- RAG Engine ---
# Token maksimal jawaban LLM (default 1024).
RAG_MAX_TOKENS=1024

# --- Keamanan & Opsional (ditambahkan 06-08-2026) ---
# Origin yang diizinkan CORS, pisahkan dengan koma. "*" = semua origin
# (catatan: kombinasi "*" + allow_credentials tidak valid; backend otomatis
# menonaktifkan credentials saat origin = "*").
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
# Rate limit per menit per IP untuk endpoint /query, /query/stream, /upload (0 = nonaktif).
RATE_LIMIT_QPM=30
# Folder log file (RotatingFileHandler). Kosongkan = log hanya ke console.
LOG_DIR=
