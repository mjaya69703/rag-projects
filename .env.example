# ==============================================================================
# PERSONAL AI KNOWLEDGE BASE (CORTEX ENGINE) — ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# LLM Provider Configuration
# Pilihan: groq, openai, anthropic, openrouter, ollama
# ------------------------------------------------------------------------------
LLM_PROVIDER=groq

# 1. Groq (Rekomendasi: Sangat Cepat & Akurat)
GROQ_API_KEY=gsk_your_groq_api_key_here
# LLM_MODEL=llama-3.3-70b-versatile

# 2. OpenAI (GPT-4o, GPT-4o-mini, o3-mini)
# OPENAI_API_KEY=sk-proj-your-openai-key-here
# LLM_MODEL=gpt-4o-mini

# 3. Anthropic (Claude 3.5 Sonnet, Claude 3.5 Haiku, Claude 3 Opus)
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
# LLM_MODEL=claude-3-5-sonnet-20241022

# 4. OpenRouter (Multi-model: Claude, Gemini, DeepSeek, Llama)
# OPENROUTER_API_KEY=sk-or-your-openrouter-key-here
# LLM_MODEL=anthropic/claude-3.5-sonnet

# 5. Ollama (100% Offline Lokal)
# LLM_API_BASE=http://localhost:11434/v1
# LLM_MODEL=llama3.2

# Parameter Generasi
LLM_TEMPERATURE=0.3
LLM_TIMEOUT=30.0

# ------------------------------------------------------------------------------
# Database & Vector Storage
# ------------------------------------------------------------------------------
DB_CONNECTION=sqlite
DB_PATH=data/chat.db
PERSIST_DIR=data/chroma_db
UPLOAD_DIR=uploads

# ------------------------------------------------------------------------------
# Security & Privacy Settings
# ------------------------------------------------------------------------------
# Sensor otomatis PII (email, nomor telepon, kredensial) sebelum dikirim ke LLM
REDACTION_ENABLED=true

# Retensi chat: hapus sesi percakapan yang tidak diakses > N hari (0 = tanpa batas)
RETAIN_CHAT_DAYS=30

# Semantic cache TTL: hapus entri cache > N hari (0 = tanpa batas)
CACHE_MAX_DAYS=30

# Proteksi API Bearer Token (opsional, kosongkan jika tanpa auth)
# AUTH_API_TOKEN=your-secret-api-token

# Rate Limiting (Permintaan per menit)
RATE_LIMIT_QPM=30

# CORS Whitelist (pisahkan dengan koma atau * untuk mengizinkan semua)
CORS_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# External Integrations (Opsional)
# ------------------------------------------------------------------------------
# Telegram Bot Token dari @BotFather
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
