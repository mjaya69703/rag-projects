# Salin file ini menjadi .env lalu isi nilainya.
# JANGAN commit .env ke git.

# --- LLM API (dipakai mulai Sprint 2) ---
LLM_API_KEY=
LLM_API_BASE=
LLM_MODEL=

# --- Path penyimpanan ---
PERSIST_DIR=data/chroma_db
UPLOAD_DIR=uploads
DB_PATH=data/chat.db

# --- RAG Engine ---
# Token maksimal jawaban LLM (default 1024).
RAG_MAX_TOKENS=1024

# --- Keamanan aplikasi (P0-02, ditambahkan 09-08-2026) ---
# API_TOKEN: isi untuk mengunci SEMUA endpoint API (kecuali /health & SPA
# statis) dengan `Authorization: Bearer <token>`. Kosong = tanpa auth
# (hanya untuk dev lokal; WAJIB diisi untuk deployment/public).
# API_TOKEN=

# --- Privasi & retensi (P0-03, ditambahkan 09-08-2026) ---
# Label provider LLM untuk disclosure UI (default: hostname LLM_API_BASE).
# LLM_PROVIDER_LABEL=
# Redaksi PII sebelum dikirim ke LLM: 1 = aktif (email, no. HP, pola rahasia).
# REDACTION_ENABLED=0
# Pola regex kustom (dipisah koma) bila REDACTION_ENABLED=1.
# REDACTION_PATTERNS=
# Retensi chat: hapus otomatis session yang tidak diakses > N hari (0 = selamanya).
# RETAIN_CHAT_DAYS=0
# Retensi semantic cache: hapus entri lebih tua dari N hari (0 = selamanya).
# CACHE_MAX_DAYS=0

# --- Keamanan & Opsional (ditambahkan 06-08-2026) ---
# Origin yang diizinkan CORS, pisahkan dengan koma. "*" = semua origin
# (catatan: kombinasi "*" + allow_credentials tidak valid; backend otomatis
# menonaktifkan credentials saat origin = "*").
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
# Rate limit per menit per IP untuk endpoint /query, /query/stream, /upload (0 = nonaktif).
RATE_LIMIT_QPM=30
# Folder log file (RotatingFileHandler). Kosongkan = log hanya ke console.
LOG_DIR=

# --- Telegram bot (fitur #14) ---
# Token bot dari @BotFather. Kosongkan = bot tidak dijalankan (exit 0).
TELEGRAM_BOT_TOKEN=
