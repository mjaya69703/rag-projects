# ==============================================================================
# PERSONAL AI KNOWLEDGE BASE (CORTEX ENGINE) — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Cara pakai:
#   cp .env.example .env   → lalu isi nilai asli di .env (JANGAN commit .env)
# Berlaku sama untuk Docker (docker compose) maupun non-Docker (start.sh).
# Variabel di bawah ini persis yang dibaca app/config.py & app/llm_client.py.

APP_NAME=Cortex
APP_VERSION=1.0
APP_DESCRIPTION="Personal AI Knowledge Base"
APP_TIMEZONE=Asia/Jakarta
APP_PORT=8000

# ------------------------------------------------------------------------------
# LLM API — OpenAI-compatible (dibaca app/llm_client.py)
# ------------------------------------------------------------------------------
# API key penyedia LLM (wajib). Contoh untuk DeepSeek / ai.databyte.co.id.
LLM_API_KEY=sk-xxx

# Base URL OpenAI-compatible. Default bila kosong: https://api.openai.com/v1
LLM_API_BASE=https://ai.databyte.co.id/v1

# Nama model (wajib). Contoh: deepseek-v4-flash, gpt-4o-mini, llama3.2
LLM_MODEL=deepseek-v4-flash

# ------------------------------------------------------------------------------
# Database & Vector Storage (dibaca app/config.py)
# ------------------------------------------------------------------------------
DB_PATH=data/chat.db
PERSIST_DIR=data/chroma_db
UPLOAD_DIR=uploads

# ------------------------------------------------------------------------------
# Security & Privacy Settings (dibaca app/config.py)
# ------------------------------------------------------------------------------
# Sensor otomatis PII (email, nomor telepon, kredensial) sebelum dikirim ke LLM
REDACTION_ENABLED=true

# Retensi chat: hapus sesi percakapan yang tidak diakses > N hari (0 = tanpa batas)
RETAIN_CHAT_DAYS=30

# Semantic cache TTL: hapus entri cache > N hari (0 = tanpa batas)
CACHE_MAX_DAYS=30

# Proteksi API Bearer Token (opsional, kosongkan jika tanpa auth)
# API_TOKEN=your-secret-api-token

# Rate Limiting (Permintaan per menit, 0 = nonaktif)
RATE_LIMIT_QPM=30

# CORS Whitelist (pisahkan dengan koma, atau * untuk mengizinkan semua)
CORS_ORIGINS=*

# ------------------------------------------------------------------------------
# Web Push Notification (reminder belajar cerdas & alert ingest)
# ------------------------------------------------------------------------------
# Identitas pengirim untuk VAPID (boleh mailto: atau URL kontak).
VAPID_SUBJECT=mailto:admin@cortex.local
# Opsional: kunci VAPID sendiri. Jika kosong, digenerate otomatis saat
# pertama kali start & disimpan persisten di data/vapid_private.pem.
# Generate manual keypair:
#   Windows:        .venv\Scripts\python -c "from py_vapid import Vapid, b64urlencode; from cryptography.hazmat.primitives.serialization import Encoding, PublicFormat; v=Vapid(); v.generate_keys(); print('PRIV:', v.private_pem().decode()); print('PUB:', b64urlencode(v.public_key.public_bytes(Encoding.X962, PublicFormat.UncompressedPoint)))"
#   Linux / macOS:  python3 -c "from py_vapid import Vapid, b64urlencode; from cryptography.hazmat.primitives.serialization import Encoding, PublicFormat; v=Vapid(); v.generate_keys(); print('PRIV:', v.private_pem().decode()); print('PUB:', b64urlencode(v.public_key.public_bytes(Encoding.X962, PublicFormat.UncompressedPoint)))"
#   Docker:         docker compose run --rm app python -c "from py_vapid import Vapid, b64urlencode; from cryptography.hazmat.primitives.serialization import Encoding, PublicFormat; v=Vapid(); v.generate_keys(); print('PRIV:', v.private_pem().decode()); print('PUB:', b64urlencode(v.public_key.public_bytes(Encoding.X962, PublicFormat.UncompressedPoint)))"
# VAPID_PRIVATE_KEY=
# VAPID_PUBLIC_KEY=

# ------------------------------------------------------------------------------
# External Integrations (Opsional, dibaca app/config.py)
# ------------------------------------------------------------------------------
# Telegram Bot Token dari @BotFather
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
